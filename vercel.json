{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/api", "destination": "/api/[...path]" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
